{
  "$schema": "../../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "bun",
  "plugins": ["../../../dist/index.js"],
  "mutate": ["src/math.ts"],
  "coverageAnalysis": "perTest",
  "disableBail": true,
  "concurrency": 2,
  "reporters": ["json"],
  "jsonReporter": { "fileName": "reports/bun.json" },
  "cleanTempDir": true,
  "logLevel": "error",
  "thresholds": { "high": 0, "low": 0, "break": null },
  "bun": {
    "testFiles": ["test/bun/math.test.ts"],
    "timeout": 1000
  }
}
